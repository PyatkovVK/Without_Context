<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:ContextGuard.App"
        x:Class="ContextGuard.App.MainWindow" Title="ContextGuard" Width="1280" Height="880"
        MinWidth="1040" MinHeight="700" WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type local:LocalizedOption}">
      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
    </DataTemplate>
  </Window.DataTemplates>
  <Grid RowDefinitions="74,*,Auto">
    <Border Grid.Row="0" Background="#111721" BorderBrush="#252D3C" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="40" Height="40" CornerRadius="12" Background="#2D2442" Margin="0,0,12,0">
          <Path Data="M 12,2 L 21,6 L 21,13 C 21,18 17,22 12,24 C 7,22 3,18 3,13 L 3,6 Z M 8,12 L 11,15 L 17,9"
                Stroke="#BAA2FF" StrokeThickness="1.6" Width="23" Height="27" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="ContextGuard" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Text[Tagline]}" Classes="muted" FontSize="11" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="#173229" CornerRadius="20" Padding="12,6">
            <TextBlock Text="{Binding Text[PrivacyBadge]}" Foreground="#76D8B2" FontSize="11" />
          </Border>
          <Button Content="{Binding Text[ClearSession]}" Classes="ghost" Command="{Binding ClearSessionCommand}" FontSize="12" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="370,*">
      <Border Grid.Column="0" Background="#111721" BorderBrush="#252D3C" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="22,22,22,24" Spacing="24" IsEnabled="{Binding NotBusy}">
            <StackPanel Spacing="11">
              <TextBlock Text="{Binding Text[AdditionalOptions]}" FontSize="11" FontWeight="SemiBold" Foreground="#AB91F3" />
              <Grid ColumnDefinitions="*,160">
                <TextBlock Text="{Binding Text[Language]}" Classes="label" VerticalAlignment="Center" />
                <ComboBox Name="LanguageSelector" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedIndex="{Binding LanguageIndex}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="11">
              <TextBlock Text="{Binding Text[FolderHeading]}" FontSize="11" FontWeight="SemiBold" Foreground="#AB91F3" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Folder}" Watermark="{Binding Text[FolderPath]}" ToolTip.Tip="{Binding Text[FolderTooltip]}" />
                <Button Grid.Column="1" Content="…" Margin="7,0,0,0" Command="{Binding BrowseCommand}" Width="40" />
              </Grid>
              <TextBlock Text="{Binding Text[FolderHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" LineHeight="17" />
            </StackPanel>

            <StackPanel Spacing="11">
              <TextBlock Text="{Binding Text[ProtectionHeading]}" FontSize="11" FontWeight="SemiBold" Foreground="#AB91F3" />
              <ComboBox Name="ProfileSelector" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />
              <TextBlock Text="{Binding Text[CustomValues]}" Classes="label" />
              <TextBox Text="{Binding CustomTerms}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="94" MaxHeight="150"
                       Watermark="{Binding Text[CustomValuesHint]}" />
              <TextBlock Text="{Binding Text[CustomValuesHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <CheckBox IsChecked="{Binding UseAgent}" Content="{Binding Text[UseAgent]}" />
              <Border Classes="card" Padding="12" IsVisible="{Binding UseAgent}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding Text[AgentHeading]}" Classes="label" />
                  <TextBox Text="{Binding AgentEndpoint}" Watermark="http://localhost:11434" />
                  <TextBox Text="{Binding AgentModel}" Watermark="{Binding Text[AgentModelHint]}" />
                  <TextBlock Text="{Binding Text[AgentHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Text[ContextLimit]}" Classes="label" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Value="{Binding ContextLimit}" Minimum="4000" Maximum="96000" Increment="4000" Width="95" FormatString="0" ShowButtonSpinner="False" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="11">
              <TextBlock Text="{Binding Text[ModelHeading]}" FontSize="11" FontWeight="SemiBold" Foreground="#AB91F3" />
              <ComboBox Name="ProviderSelector" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" />
              <StackPanel Spacing="9" IsVisible="{Binding IsOllama}">
                <TextBox Text="{Binding OllamaEndpoint}" Watermark="http://localhost:11434" />
                <ComboBox ItemsSource="{Binding LocalModels}" SelectedItem="{Binding LocalModel}" PlaceholderText="{Binding Text[LocalModelsHint]}" />
                <TextBox Text="{Binding LocalModel}" Watermark="{Binding Text[ModelNameHint]}" />
                <Button Content="{Binding Text[RefreshModels]}" Command="{Binding RefreshModelsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <TextBlock Text="{Binding Text[OllamaHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="9" IsVisible="{Binding IsRemote}">
                <TextBlock Text="{Binding Text[ApiEndpoint]}" Classes="label" />
                <TextBox Text="{Binding ApiEndpoint}" Watermark="https://…/v1/chat/completions" />
                <TextBox Text="{Binding ApiModel}" Watermark="{Binding Text[ApiModelHint]}" />
                <TextBox Text="{Binding ApiKey}" PasswordChar="●" Watermark="{Binding Text[ApiKeyHint]}" />
                <TextBlock Text="{Binding Text[ApiHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <Button Content="{Binding Text[FindAgentModels]}" Command="{Binding RefreshModelsCommand}" IsVisible="{Binding UseAgent}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="#252D3C" BorderThickness="0,1,0,0" Padding="22,15,22,18">
          <StackPanel Spacing="9">
            <Button Content="{Binding Text[PrepareContext]}" Classes="primary" Command="{Binding PrepareCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <TextBlock Text="{Binding Text[StorageHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" LineHeight="17" />
          </StackPanel>
        </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="24,20,24,18">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
          <StackPanel Spacing="5">
            <TextBlock Text="{Binding Text[Workspace]}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="1" Background="#241F35" CornerRadius="18" Padding="12,6" VerticalAlignment="Top" Margin="12,0,0,0">
            <TextBlock Text="{Binding CountSummary}" Foreground="#C6B4F4" FontSize="11" />
          </Border>
        </Grid>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
          <TabItem Header="{Binding Text[ChatTab]}">
            <Grid RowDefinitions="*,Auto,Auto" Margin="0,14,0,0">
              <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Spacing="15" IsVisible="{Binding !HasChat}">
                  <Border Background="#211E31" Width="62" Height="62" CornerRadius="18" HorizontalAlignment="Center">
                    <TextBlock Text="✦" Foreground="#BAA2FF" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding Text[WelcomeTitle]}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Text[WelcomeHelp]}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" />
                  <Border Classes="card" Padding="18" Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding Text[Pipeline]}" Foreground="#C6B4F4" FontSize="12" TextAlignment="Center" />
                      <TextBlock Text="{Binding Text[AnswerHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <ScrollViewer Name="ChatScroll" IsVisible="{Binding HasChat}" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Chat}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="card" Padding="17,14" Margin="0,0,0,12">
                          <StackPanel Spacing="9">
                            <TextBlock Text="{Binding Label}" Foreground="{Binding Color}" FontSize="10" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0"
                                     Background="Transparent" Padding="0" MinHeight="0" FontSize="13" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
              <StackPanel Grid.Row="1" Spacing="8" Margin="0,14,0,12">
                <Grid ColumnDefinitions="*,Auto">
                  <CheckBox IsChecked="{Binding RestoreLocally}" IsEnabled="{Binding NotBusy}" Content="{Binding Text[RestoreLocally]}" FontSize="11" />
                  <Button Grid.Column="1" Content="{Binding Text[NewChat]}" Classes="ghost" FontSize="11" Command="{Binding NewChatCommand}" />
                </Grid>
                <Border Classes="card" Padding="14" IsVisible="{Binding HasPending}">
                  <StackPanel Spacing="10" IsEnabled="{Binding NotBusy}">
                    <TextBlock Text="{Binding Text[MessageReviewHeading]}" FontSize="10" FontWeight="SemiBold" Foreground="#C6B4F4" />
                    <TextBox Text="{Binding PendingText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                      <Button Content="{Binding Text[BackToMessage]}" Classes="ghost" Command="{Binding EditPromptCommand}" />
                      <Button Content="{Binding Text[Send]}" Classes="primary" Command="{Binding SendCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
              <Border Grid.Row="2" Classes="card" Padding="12">
                <Grid RowDefinitions="*,Auto" IsEnabled="{Binding CanCompose}">
                  <TextBox Name="PromptBox" Text="{Binding Prompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="145"
                           Background="Transparent" BorderThickness="0" Padding="3" Watermark="{Binding Text[PromptHint]}" />
                  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,9,0,0">
                    <TextBlock Text="{Binding Text[PreviewShortcut]}" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding Text[ReviewMessage]}" Classes="primary" Command="{Binding PreviewPromptCommand}" />
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="{Binding Text[ContextTab]}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="0,14,0,0">
              <Border Classes="card" Padding="14" Margin="0,0,0,12">
                <TextBlock Text="{Binding Text[ContextHelp]}" Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="19" />
              </Border>
              <TextBox Grid.Row="1" Text="{Binding ContextText}" AcceptsReturn="True" TextWrapping="Wrap" IsEnabled="{Binding NotBusy}"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="12" Watermark="{Binding Text[ContextHint]}" />
              <Border Grid.Row="2" Classes="card" Padding="14" Margin="0,12,0,0">
                <CheckBox IsChecked="{Binding ContextApproved}" IsEnabled="{Binding CanReview}">
                  <TextBlock Text="{Binding Text[ApproveContext]}" TextWrapping="Wrap" FontSize="12" />
                </CheckBox>
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="{Binding Text[ReplacementsTab]}">
            <Grid RowDefinitions="Auto,*" Margin="0,14,0,0">
              <Border Classes="card" Padding="14" Margin="0,0,0,12">
                <TextBlock Text="{Binding Text[ReplacementsHelp]}" Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="19" />
              </Border>
              <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Replacements}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card" Padding="13,11" Margin="0,0,0,7">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Placeholder}" FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="12" />
                          <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#BBA5ED" FontSize="11" Margin="12,0,0,0" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </TabItem>
          <TabItem Header="{Binding Text[FilesTab]}">
            <Grid RowDefinitions="Auto,*" Margin="0,14,0,0">
              <Border Classes="card" Padding="14" Margin="0,0,0,12">
                <TextBlock Text="{Binding Text[FilesHelp]}" Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="19" />
              </Border>
              <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Files}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card" Padding="13,11" Margin="0,0,0,7">
                        <StackPanel Spacing="5">
                          <TextBlock Text="{Binding Alias}" Foreground="#BBA5ED" FontSize="12" />
                          <SelectableTextBlock Text="{Binding LocalRelativePath}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>

    <StackPanel Grid.Row="2">
      <Border Background="#392029" BorderBrush="#68323C" BorderThickness="0,1,0,0" Padding="20,12" IsVisible="{Binding HasError}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Error}" Foreground="#FFC0C7" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
          <Button Grid.Column="1" Content="✕" Classes="ghost" Command="{Binding DismissErrorCommand}" />
        </Grid>
      </Border>
      <Border Background="#111721" BorderBrush="#252D3C" BorderThickness="0,1,0,0" Padding="22,10">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <ProgressBar Width="65" Height="3" IsIndeterminate="True" IsVisible="{Binding Busy}" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="#AB91F3" />
          <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="{Binding Text[Stop]}" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}" Classes="ghost" FontSize="11" Margin="12,0,0,0" />
        </Grid>
      </Border>
    </StackPanel>
  </Grid>
</Window>
