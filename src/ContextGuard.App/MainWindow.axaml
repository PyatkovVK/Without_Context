<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ContextGuard.App" x:Class="ContextGuard.App.MainWindow" Title="Without Context" Icon="/images/icon.png"
        Width="1448" Height="920" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Grid>
  <Grid Name="WorkspaceSurface" Margin="12" IsEnabled="{Binding !ModalOpen}" IsHitTestVisible="{Binding !ModalOpen}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" />
      <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Border Name="ChatsSidebar" Grid.Column="0" Classes="panel" Width="{Binding ChatsSidebarPixels}" ClipToBounds="True" Padding="{Binding ChatsSidebarPadding}">
      <Border.Transitions><Transitions><DoubleTransition Property="Width" Duration="0:0:0.5" Easing="CubicEaseInOut" /><ThicknessTransition Property="Padding" Duration="0:0:0.5" Easing="CubicEaseInOut" /></Transitions></Border.Transitions>
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Grid Name="ChatsHeader" ColumnDefinitions="*,44" Width="{Binding ChatsHeaderPixels}" HorizontalAlignment="Left" Margin="0,0,0,24">
          <Grid.Transitions><Transitions><DoubleTransition Property="Width" Duration="0:0:0.5" Easing="CubicEaseInOut" /></Transitions></Grid.Transitions>
          <Grid ColumnDefinitions="40,*" Width="{Binding ChatsBrandPixels}" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Center" local:SmoothVisibility.Motion="Sidebar" local:SmoothVisibility.IsShown="{Binding ChatsSidebarOpen}">
            <Grid.Transitions><Transitions><DoubleTransition Property="Width" Duration="0:0:0.5" Easing="CubicEaseInOut" /><DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut" /></Transitions></Grid.Transitions>
            <Image Source="/images/icon.png" Width="40" Height="40" Stretch="Uniform" />
            <TextBlock Grid.Column="1" Text="Without Context" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,8,0" TextTrimming="CharacterEllipsis" />
          </Grid>
          <Button Name="ToggleChatsButton" Grid.Column="1" Command="{Binding ToggleChatsCommand}" Classes="icon sidebar-toggle" ToolTip.Tip="{Binding ChatsToggleTip}" AutomationProperties.Name="{Binding ChatsToggleTip}">
            <Grid><Path Classes="outline sidebar-chevron" Data="{StaticResource ChevronLeftIcon}" IsVisible="{Binding ChatsSidebarOpen}" /><Path Classes="outline sidebar-chevron" Data="{StaticResource ChevronRightIcon}" IsVisible="{Binding !ChatsSidebarOpen}" /></Grid>
          </Button>
        </Grid>
        <Button Grid.Row="1" Name="NewChatButton" IsEnabled="{Binding ChatsSidebarOpen}" Command="{Binding NewChatCommand}" Width="{Binding ChatsBodyWidth}" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Height="52" Padding="16,0" Margin="0,0,0,26" local:SmoothVisibility.Motion="Sidebar" local:SmoothVisibility.IsShown="{Binding ChatsSidebarOpen}">
          <Grid ColumnDefinitions="20,*,20"><Path Classes="outline" Data="{StaticResource PlusIcon}" VerticalAlignment="Center" /><TextBlock Name="NewChatLabel" Grid.Column="1" Text="{Binding Text[NewChat]}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
        </Button>
        <Button Grid.Row="1" Name="CollapsedNewChatButton" HorizontalAlignment="Left" Command="{Binding NewChatCommand}" IsEnabled="{Binding !ChatsSidebarOpen}" local:SmoothVisibility.IsShown="{Binding !ChatsSidebarOpen}" Classes="icon sidebar-toggle" ToolTip.Tip="{Binding Text[NewChat]}"><Path Classes="outline" Data="{StaticResource PlusIcon}" /></Button>
        <TextBlock Grid.Row="2" Text="{Binding ChatListHeading}" Classes="muted" FontSize="12" Margin="10,0,0,10" local:SmoothVisibility.Motion="Sidebar" local:SmoothVisibility.IsShown="{Binding ChatsSidebarOpen}" />
        <ListBox Name="ConversationsList" Grid.Row="3" Width="{Binding ChatsBodyWidth}" HorizontalAlignment="Left" ItemsSource="{Binding VisibleConversations}" SelectedItem="{Binding Active}" local:SmoothVisibility.Motion="Sidebar" local:SmoothVisibility.IsShown="{Binding ChatsSidebarOpen}" IsEnabled="{Binding CanUseChatList}" Background="Transparent" BorderThickness="0" ItemContainerTheme="{StaticResource ChatItemTheme}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="22,*,Auto,28">
                <Path Classes="outline" Data="{StaticResource ChatIcon}" Width="18" Height="18" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" Margin="10,0,6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Title}" />
                <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Button Name="ChatRowMenuButton" Grid.Column="3" Classes="icon" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="4,0" VerticalAlignment="Center" ToolTip.Tip="{Binding Session.Text[ChatActionsLabel]}" AutomationProperties.Name="{Binding Session.Text[ChatActionsLabel]}">
                  <TextBlock Text="⋮" FontSize="20" VerticalAlignment="Center" />
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="{Binding ArchiveActionLabel}" Command="{Binding ArchiveCommand}" />
                      <MenuItem Header="{Binding Session.Text[DeleteChat]}" Command="{Binding DeleteCommand}" Classes="danger" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="4" IsEnabled="{Binding ChatsSidebarOpen}" MinHeight="44" Spacing="5" Width="{Binding ChatsBodyWidth}" HorizontalAlignment="Left" local:SmoothVisibility.Motion="Sidebar" local:SmoothVisibility.IsShown="{Binding ChatsSidebarOpen}">
          <Button Name="ArchivesButton" IsVisible="{Binding HasArchivedChats}" Command="{Binding ToggleArchiveViewCommand}" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="13"><Path Classes="outline" Data="{StaticResource ArchiveIcon}" Width="18" Height="18" /><TextBlock Text="{Binding ArchiveNavigationLabel}" FontSize="13" /></StackPanel>
          </Button>
          <Button Name="SettingsButton" Command="{Binding SettingsCommand}" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="13"><Path Classes="outline" Data="{StaticResource SettingsIcon}" Width="18" Height="18" /><TextBlock Text="{Binding Text[Settings]}" FontSize="13" /></StackPanel>
          </Button>
        </StackPanel>
        <Button Grid.Row="4" Name="CollapsedSettingsButton" Command="{Binding SettingsCommand}" Classes="icon sidebar-toggle" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                IsEnabled="{Binding !ChatsSidebarOpen}" local:SmoothVisibility.IsShown="{Binding !ChatsSidebarOpen}"
                ToolTip.Tip="{Binding Text[Settings]}" AutomationProperties.Name="{Binding Text[Settings]}">
          <Path Classes="outline" Data="{StaticResource SettingsIcon}" />
        </Button>
      </Grid>
    </Border>

    <Border Grid.Column="2" Classes="panel" Background="{StaticResource ChatBackground}" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Grid RowDefinitions="Auto,Auto" Margin="24,18,22,14">
          <Grid>
            <Button Name="ChatActions" Classes="ghost" Padding="0" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Active.Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="{Binding TitleMaxWidth}" /><TextBlock Text="⌄" Classes="muted" /></StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Spacing="4">
                    <Button Content="{Binding Text[ChatTab]}" Command="{Binding Active.Session.ShowChatCommand}" Click="CloseChatMenu" Classes="ghost" HorizontalAlignment="Stretch" />
                    <Button Content="{Binding Text[ContextTab]}" Command="{Binding Active.Session.ShowContextCommand}" Click="CloseChatMenu" Classes="ghost" HorizontalAlignment="Stretch" />
                    <Button Content="{Binding Text[ReplacementsTab]}" Command="{Binding Active.Session.ShowReplacementsCommand}" Click="CloseChatMenu" Classes="ghost" HorizontalAlignment="Stretch" />
                    <Button Content="{Binding Text[FilesTab]}" Command="{Binding Active.Session.ShowFilesCommand}" Click="CloseChatMenu" Classes="ghost" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <Button Content="{Binding Active.Session.AssistantModelName}" Command="{Binding OpenModelOptionsCommand}" Classes="ghost" FontSize="12" Padding="0" HorizontalAlignment="Left" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="13">
              <Button Name="ToggleCleanerButton" Command="{Binding Active.Session.ToggleCleanerCommand}" Classes="ghost" Padding="3,2" MinHeight="24" ToolTip.Tip="{Binding Active.Session.CleanerToggleTip}" AutomationProperties.Name="{Binding Active.Session.CleanerToggleTip}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="6" Height="6" Fill="{Binding Active.Session.CleanerConnectionColor}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Text[CleanerModel]}" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                <TextBlock Name="CleanerSignal" Text="{Binding Active.Session.CleanerConnectionLabel}" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
              </Button>
              <Button Name="ToggleAssistantButton" Command="{Binding Active.Session.ToggleAssistantCommand}" Classes="ghost" Padding="3,2" MinHeight="24" ToolTip.Tip="{Binding Active.Session.AssistantToggleTip}" AutomationProperties.Name="{Binding Active.Session.AssistantToggleTip}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="6" Height="6" Fill="{Binding Active.Session.ChatConnectionColor}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Text[AssistantModel]}" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                <TextBlock Name="ChatSignal" Text="{Binding Active.Session.ChatConnectionLabel}" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>

        <Grid Grid.Row="1" DataContext="{Binding Active.Session}" Margin="14,0,14,12">
          <Grid Name="MainWorkArea" IsVisible="{Binding ShowMainWorkArea}">
          <Grid local:SmoothVisibility.Motion="View" local:SmoothVisibility.IsShown="{Binding IsChatView}" RowDefinitions="*,Auto,Auto,Auto">
            <Grid ClipToBounds="True">
              <StackPanel IsVisible="{Binding ShowWelcome}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Spacing="16" Margin="24">
                <Path Data="{StaticResource ShieldIcon}" Classes="outline" Width="48" Height="48" Stroke="#369AFF" />
                <TextBlock Text="{Binding WorkspaceWelcomeTitle}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WorkspaceWelcomeHelp}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" />
                <Button Name="StartWorkButton" IsVisible="{Binding CanStartContextPreparation}" Content="{Binding Text[PrepareShort]}" Command="{Binding PrepareCommand}" HorizontalAlignment="Center" Classes="primary" />
              </StackPanel>
              <ScrollViewer Name="ChatScroll" IsVisible="{Binding HasChat}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="{Binding $parent[Window].DataContext.ChatScrollBarVisibility}">
                <ItemsControl ItemsSource="{Binding Chat}" Margin="8,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="40,*,40" Margin="0,0,0,22">
                        <Border Width="34" Height="34" CornerRadius="17" BorderThickness="1" BorderBrush="#2B4053" VerticalAlignment="Top" IsVisible="{Binding IsAssistant}">
                          <Path Data="{StaticResource ShieldIcon}" Classes="outline" Width="20" Height="22" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" Spacing="6">
                          <Border IsVisible="{Binding !IsAssistant}" Background="#1A2B3C" CornerRadius="18" Padding="16,12" HorizontalAlignment="Right" MaxWidth="600">
                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="#DDE6F0" />
                          </Border>
                          <local:ReplyContent IsVisible="{Binding IsAssistant}" Text="{Binding Text}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="7" VerticalAlignment="Top" HorizontalAlignment="Center">
                          <Border IsVisible="{Binding !IsAssistant}" Width="34" Height="34" CornerRadius="17" Background="#244661"><Path Data="{StaticResource UserIcon}" Classes="outline" Width="18" Height="20" /></Border>
                          <TextBlock Text="{Binding TimeLabel}" Classes="muted" FontSize="10" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
            <Border Grid.Row="1" Classes="card" IsVisible="{Binding HasPending}" Padding="14" Margin="0,8,0,10">
              <StackPanel Spacing="10" IsEnabled="{Binding NotBusy}">
                <TextBlock Text="{Binding Text[ReviewMessageShort]}" FontSize="12" FontWeight="SemiBold" />
                <TextBox Text="{Binding PendingText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" MaxHeight="130" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                  <Button Content="{Binding Text[BackToMessage]}" Classes="ghost" Command="{Binding EditPromptCommand}" />
                  <Button Content="{Binding Text[Send]}" Classes="primary" Command="{Binding SendCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Classes="card" Padding="14,7,10,7" Background="#0F1F2E">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Name="PromptBox" Classes="composer" Text="{Binding Prompt}" IsEnabled="{Binding CanCompose}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" MaxHeight="135" Background="Transparent" BorderThickness="0" Padding="5,7" Watermark="{Binding Text[MessagePlaceholder]}" />
                <Button Grid.Column="1" Command="{Binding PreviewPromptCommand}" Classes="primary round" VerticalAlignment="Bottom" ToolTip.Tip="{Binding Text[ReviewMessage]}"><Path Classes="outline" Data="{StaticResource ArrowIcon}" Stroke="#052139" Width="18" Height="20" /></Button>
              </Grid>
            </Border>
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="8,6,8,0">
              <TextBlock Text="{Binding Status}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="Ctrl+Enter" Classes="muted" FontSize="10" Margin="8,0,0,0" />
            </Grid>
          </Grid>

          <Grid Name="ContextView" local:SmoothVisibility.Motion="View" local:SmoothVisibility.IsShown="{Binding IsContextView}" RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="8,5">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
              <StackPanel Spacing="5"><TextBlock Text="{Binding Text[FolderContext]}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel>
              <Button Grid.Column="1" Content="{Binding Text[BackToChat]}" Classes="ghost" Command="{Binding ShowChatCommand}" />
            </Grid>
            <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,14" IsEnabled="{Binding NotBusy}">
              <TextBlock Text="{Binding Text[ContextHelp]}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TrimmingSummary}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <TextBox Grid.Row="2" Text="{Binding ContextText}" AcceptsReturn="True" TextWrapping="Wrap" IsEnabled="{Binding NotBusy}" FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="12" Watermark="{Binding Text[ContextHint]}" />
            <CheckBox Grid.Row="3" IsChecked="{Binding ContextApproved}" IsEnabled="{Binding CanReview}" Margin="0,14,0,10"><TextBlock Text="{Binding Text[ApproveContext]}" TextWrapping="Wrap" FontSize="12" /></CheckBox>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="7"><Button Content="{Binding Text[ReplacementsTab]}" Command="{Binding ShowReplacementsCommand}" Classes="ghost" /><Button Content="{Binding Text[FilesTab]}" Command="{Binding ShowFilesCommand}" Classes="ghost" /></StackPanel>
          </Grid>
          <Grid local:SmoothVisibility.Motion="View" local:SmoothVisibility.IsShown="{Binding IsReplacementsView}" RowDefinitions="Auto,*" Margin="8,5">
            <StackPanel Spacing="10" Margin="0,0,0,14"><Button Content="{Binding Text[BackToChat]}" Command="{Binding ShowChatCommand}" Classes="ghost" HorizontalAlignment="Left" /><TextBlock Text="{Binding Text[ReplacementsHelp]}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Replacements}"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Classes="card" Padding="12" Margin="0,0,0,7"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Placeholder}" FontFamily="Consolas,Menlo,monospace" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding Category}" Classes="muted" FontSize="11" Margin="12,0,0,0" /></Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          </Grid>
          <Grid local:SmoothVisibility.Motion="View" local:SmoothVisibility.IsShown="{Binding IsFilesView}" RowDefinitions="Auto,*" Margin="8,5">
            <StackPanel Spacing="10" Margin="0,0,0,14"><Button Content="{Binding Text[BackToChat]}" Command="{Binding ShowChatCommand}" Classes="ghost" HorizontalAlignment="Left" /><TextBlock Text="{Binding Text[FilesHelp]}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel><ItemsControl ItemsSource="{Binding Files}"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Classes="card" Padding="12" Margin="0,0,0,7"><StackPanel Spacing="5"><TextBlock Text="{Binding Alias}" FontSize="12" FontWeight="SemiBold" /><SelectableTextBlock Text="{Binding LocalRelativePath}" TextWrapping="Wrap" FontSize="11" Classes="muted" /></StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <ItemsControl ItemsSource="{Binding SkippedFiles}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Classes="card" Padding="12" Margin="0,0,0,7"><StackPanel Spacing="5"><TextBlock Text="{Binding LocalRelativePath}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding Reason}" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></ScrollViewer>
          </Grid>
          </Grid>
          <ScrollViewer Name="SetupGate" IsVisible="{Binding ShowSetupGate}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" MaxWidth="440" Spacing="16" Margin="24,32">
              <Path Data="{StaticResource ShieldIcon}" Classes="outline" Width="46" Height="46" Stroke="#369AFF" />
              <TextBlock Text="{Binding Text[ConnectModelTitle]}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Text[SetupRequiredHelp]}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" />
              <Border Classes="card" Padding="16">
                <StackPanel Spacing="18">
                  <Grid ColumnDefinitions="12,*,Auto">
                    <Ellipse Width="8" Height="8" Fill="{Binding AssistantReadinessColor}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0" Spacing="4"><TextBlock Text="{Binding Text[TaskModelTitle]}" FontWeight="SemiBold" /><TextBlock Text="{Binding ChatConnectionLabel}" Foreground="{Binding ChatConnectionColor}" FontSize="12" /></StackPanel>
                    <Button Grid.Column="2" Content="{Binding Text[Configure]}" Command="{Binding $parent[Window].DataContext.OpenModelOptionsCommand}" Classes="ghost" FontSize="12" />
                  </Grid>
                  <Grid ColumnDefinitions="12,*,Auto">
                    <Ellipse Width="8" Height="8" Fill="{Binding CleanerReadinessColor}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0" Spacing="4"><TextBlock Text="{Binding Text[LocalOllamaChatTitle]}" FontWeight="SemiBold" /><TextBlock Text="{Binding CleanerConnectionLabel}" Foreground="{Binding CleanerConnectionColor}" FontSize="12" /></StackPanel>
                    <Button Grid.Column="2" Content="{Binding Text[Configure]}" Command="{Binding $parent[Window].DataContext.OpenCleanerOptionsCommand}" Classes="ghost" FontSize="12" />
                  </Grid>
                  <Grid ColumnDefinitions="12,*,Auto">
                    <Ellipse Width="8" Height="8" Fill="{Binding FolderReadinessColor}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0" Spacing="4"><TextBlock Text="{Binding Text[FolderOptionalTitle]}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Folder}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="200" /></StackPanel>
                    <Button Grid.Column="2" Content="{Binding Text[ChooseFolderShort]}" Command="{Binding BrowseCommand}" Classes="ghost" FontSize="12" />
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding Text[SupportedContextFiles]}" Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </ScrollViewer>
          <Border Background="#391E29" BorderBrush="#6C3042" BorderThickness="1" CornerRadius="10" Padding="12" IsVisible="{Binding HasError}" VerticalAlignment="Bottom" Margin="0,0,0,85">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Error}" Foreground="#F3B7C3" TextWrapping="Wrap" FontSize="12" /><Button Grid.Column="1" Content="×" Classes="icon" Command="{Binding DismissErrorCommand}" /></Grid>
          </Border>
          <Border Background="#122B41" CornerRadius="10" IsVisible="{Binding Busy}" VerticalAlignment="Bottom" Padding="12" Margin="0,0,0,85">
            <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="8"><TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" /><ProgressBar Height="3" IsIndeterminate="True" /></StackPanel><Button Grid.Column="1" Content="{Binding Text[Stop]}" Command="{Binding CancelCommand}" Classes="ghost" Margin="8,0,0,0" /></Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <Border Name="ModelsSidebar" Grid.Column="4" Classes="panel" Width="{Binding ModelsSidebarPixels}" ClipToBounds="True" Padding="{Binding ModelsSidebarPadding}">
      <Border.Transitions><Transitions><DoubleTransition Property="Width" Duration="0:0:0.5" Easing="CubicEaseInOut" /><ThicknessTransition Property="Padding" Duration="0:0:0.5" Easing="CubicEaseInOut" /></Transitions></Border.Transitions>
      <Grid RowDefinitions="Auto,*">
        <Grid Name="ModelsHeader" ColumnDefinitions="*,44" Width="{Binding ModelsHeaderPixels}" HorizontalAlignment="Left" Margin="0,0,0,22">
          <Grid.Transitions><Transitions><DoubleTransition Property="Width" Duration="0:0:0.5" Easing="CubicEaseInOut" /></Transitions></Grid.Transitions>
          <Grid ColumnDefinitions="*,34" Width="{Binding ModelsBrandPixels}" ClipToBounds="True" HorizontalAlignment="Left" IsEnabled="{Binding ModelsSidebarOpen}" local:SmoothVisibility.Motion="Sidebar" local:SmoothVisibility.IsShown="{Binding ModelsSidebarOpen}">
            <Grid.Transitions><Transitions><DoubleTransition Property="Width" Duration="0:0:0.5" Easing="CubicEaseInOut" /><DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut" /></Transitions></Grid.Transitions>
            <TextBlock Text="{Binding Text[ChatSettings]}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Name="ModelChatActionsButton" Grid.Column="1" Classes="icon" Width="34" Height="34" MinWidth="34" MinHeight="34" Padding="4,0" IsEnabled="{Binding NotBusy}" ToolTip.Tip="{Binding Text[ChatActionsLabel]}" AutomationProperties.Name="{Binding Text[ChatActionsLabel]}">
              <TextBlock Text="⋮" FontSize="22" VerticalAlignment="Center" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <Flyout.FlyoutPresenterTheme>
                    <ControlTheme TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
                      <Setter Property="Background" Value="#0D1C2A" /><Setter Property="BorderBrush" Value="#294055" /><Setter Property="BorderThickness" Value="1" />
                      <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="8" />
                    </ControlTheme>
                  </Flyout.FlyoutPresenterTheme>
                  <StackPanel Width="240" Spacing="5">
                    <Button Name="ExportChatButton" Content="{Binding Text[ExportChat]}" Command="{Binding ExportChatCommand}" Click="CloseModelChatActionsMenu" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="32" Padding="10,6" FontSize="12" />
                    <Button Name="ArchiveChatButton" Command="{Binding ArchiveChatCommand}" Click="CloseModelChatActionsMenu" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="34" MinHeight="34" Padding="10,6" ToolTip.Tip="{Binding ArchiveActionHelp}">
                      <Grid ColumnDefinitions="18,*"><Path Classes="outline" Width="16" Height="16" Data="{StaticResource ArchiveIcon}" /><TextBlock Grid.Column="1" Text="{Binding ArchiveActionLabel}" Margin="9,0,0,0" FontSize="12" VerticalAlignment="Center" /></Grid>
                    </Button>
                    <Button Name="DeleteChatButton" Command="{Binding DeleteChatCommand}" Click="CloseModelChatActionsMenu" Classes="danger" HorizontalAlignment="Stretch" Height="34" MinHeight="34" Padding="10,6" ToolTip.Tip="{Binding Text[DeleteChatHelp]}">
                      <Grid ColumnDefinitions="18,*"><Path Classes="outline" Width="16" Height="16" Data="{StaticResource TrashIcon}" Stroke="#FF5267" /><TextBlock Grid.Column="1" Text="{Binding Text[DeleteChat]}" Margin="9,0,0,0" FontSize="12" VerticalAlignment="Center" /></Grid>
                    </Button>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <Button Name="ToggleModelsButton" Grid.Column="1" Command="{Binding ToggleModelsCommand}" Classes="icon sidebar-toggle" ToolTip.Tip="{Binding ModelsToggleTip}" AutomationProperties.Name="{Binding ModelsToggleTip}"><Grid><Path Classes="outline" Data="{StaticResource CloseIcon}" Width="24" Height="24" IsVisible="{Binding ModelsSidebarOpen}" /><Path Classes="outline sidebar-chevron" Data="{StaticResource ChevronLeftIcon}" IsVisible="{Binding !ModelsSidebarOpen}" /></Grid></Button>
        </Grid>
        <ScrollViewer Name="ModelSettingsScroll" IsEnabled="{Binding ModelsSidebarOpen}" Grid.Row="1" Width="{Binding ModelsBodyWidth}" HorizontalAlignment="Left" local:SmoothVisibility.Motion="Sidebar" local:SmoothVisibility.IsShown="{Binding ModelsSidebarOpen}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
          <StackPanel Spacing="18" DataContext="{Binding Active.Session}" IsEnabled="{Binding NotBusy}">
            <StackPanel Name="FolderContextOptions" Spacing="10">
              <TextBlock Text="{Binding Text[FolderContext]}" Classes="label" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Name="FolderBox" Text="{Binding Folder}" Watermark="{Binding Text[FolderPath]}" ToolTip.Tip="{Binding Text[FolderTooltip]}" />
                <Button Grid.Column="1" Command="{Binding BrowseCommand}" Margin="7,0,0,0" ToolTip.Tip="{Binding Text[FolderPickerTitle]}"><Path Classes="outline" Data="{StaticResource FolderIcon}" /></Button>
              </Grid>
              <Grid ColumnDefinitions="*,Auto"><Button Content="{Binding Text[PrepareShort]}" Command="{Binding PrepareCommand}" HorizontalAlignment="Stretch" /><Button Grid.Column="1" Content="{Binding Text[Review]}" Command="{Binding ShowContextCommand}" Classes="ghost" Margin="7,0,0,0" /></Grid>
              <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding Text[LocalCleanerTitle]}" Classes="label" />
              <Border Name="CleanerConnectedCard" IsVisible="{Binding ShowCleanerSummary}" Background="#102B26" BorderBrush="#245F4E" BorderThickness="1" CornerRadius="11" Padding="12">
                <Grid ColumnDefinitions="*,34">
                  <StackPanel Spacing="7"><TextBlock Text="{Binding AgentModel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="7" Height="7" Fill="{Binding CleanerConnectionColor}" VerticalAlignment="Center" /><TextBlock Text="{Binding CleanerConnectionLabel}" Foreground="{Binding CleanerConnectionColor}" FontSize="12" /></StackPanel><TextBlock Text="{Binding Text[OnThisComputer]}" Classes="muted" FontSize="11" /></StackPanel>
                  <Button Name="EditCleanerButton" Grid.Column="1" Command="{Binding EditCleanerCommand}" Classes="icon" VerticalAlignment="Top" ToolTip.Tip="{Binding Text[EditModel]}" AutomationProperties.Name="{Binding Text[EditModel]}"><TextBlock Text="✎" FontSize="20" /></Button>
                </Grid>
              </Border>
              <Expander Classes="model" Name="CleanerOptions" IsVisible="{Binding ShowCleanerEditor}" IsExpanded="{Binding CleanerModelExpanded}">
                <Expander.Header><StackPanel Orientation="Horizontal" Spacing="13"><Path Classes="outline" Data="{StaticResource MonitorIcon}" /><TextBlock Text="{Binding CleanerModelName}" TextTrimming="CharacterEllipsis" MaxWidth="190" /></StackPanel></Expander.Header>
                <StackPanel Spacing="10" Margin="12,6,12,14">
                  <CheckBox IsChecked="{Binding UseAgent}" Content="{Binding Text[EnableCleaner]}" />
                  <TextBlock Name="OllamaSetupStatus" Text="{Binding OllamaSetupMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Name="OllamaExecutablePath" Text="{Binding OllamaExecutable}" IsVisible="{Binding HasOllamaExecutable}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OllamaExecutable}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <Button Name="FindOllamaButton" Content="{Binding Text[FindOllama]}" Command="{Binding FindOllamaCommand}" Classes="ghost" FontSize="12" Padding="8,6" />
                    <Button Name="DetectOllamaButton" Grid.Column="1" Content="↻" Command="{Binding DetectOllamaCommand}" Classes="icon" ToolTip.Tip="{Binding Text[CheckOllama]}" AutomationProperties.Name="{Binding Text[CheckOllama]}" />
                  </Grid>
                  <Button Name="DownloadOllamaButton" Content="{Binding Text[DownloadOllama]}" Command="{Binding DownloadOllamaCommand}" IsVisible="{Binding NeedsOllamaDownload}" FontSize="12" />
                  <Button Name="StartOllamaButton" Content="{Binding Text[StartOllama]}" Command="{Binding StartOllamaCommand}" IsVisible="{Binding CanStartOllama}" FontSize="12" />
                  <StackPanel Name="InstalledAgentModels" Spacing="7" IsVisible="{Binding IsOllamaRunning}">
                    <TextBlock Text="{Binding Text[InstalledLocalModels]}" FontSize="12" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto">
                      <ComboBox Name="AgentModelSelector" ItemsSource="{Binding AgentModels}" SelectedItem="{Binding SelectedAgentModel}" IsEnabled="{Binding HasAgentModels}" PlaceholderText="{Binding Text[LocalModelsHint]}" AutomationProperties.Name="{Binding Text[InstalledLocalModels]}" />
                      <Button Name="RefreshInstalledModelsButton" Grid.Column="1" Content="↻" Command="{Binding RefreshAgentModelsCommand}" Classes="icon" Margin="7,0,0,0" ToolTip.Tip="{Binding Text[RefreshModels]}" AutomationProperties.Name="{Binding Text[RefreshModels]}" />
                    </Grid>
                    <TextBlock Name="NoInstalledModelsHint" Text="{Binding Text[OllamaNoInstalledModels]}" IsVisible="{Binding NoInstalledAgentModels}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Text[OllamaSelectedModelMissing]}" IsVisible="{Binding SelectedAgentModelUnavailable}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    <Button Content="{Binding Text[Connect]}" Command="{Binding CheckCleanerCommand}" />
                  </StackPanel>
                  <StackPanel Name="DownloadableAgentModels" Spacing="7" IsVisible="{Binding IsOllamaRunning}">
                    <TextBlock Name="DownloadableModelsLabel" Text="{Binding Text[FreeLocalModels]}" FontSize="12" FontWeight="SemiBold" />
                    <ComboBox Name="DownloadableAgentModelSelector" ItemsSource="{Binding DownloadableAgentModels}" SelectedItem="{Binding SelectedDownloadableAgentModel}" PlaceholderText="{Binding Text[ChooseDownloadModel]}" AutomationProperties.Name="{Binding Text[FreeLocalModels]}">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Model}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Name="ModelDownloadHint" Text="{Binding ModelDownloadHint}" IsVisible="{Binding HasSelectedDownloadableAgentModel}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    <Expander Header="{Binding Text[OtherLocalModel]}" FontSize="12">
                      <TextBox Name="OllamaPullModelBox" Text="{Binding ModelToInstall}" MaxLength="200" Watermark="qwen3:4b" FontSize="12" Margin="0,6,0,0" />
                    </Expander>
                    <Button Name="InstallOllamaModelButton" Content="{Binding Text[InstallInTerminal]}" Command="{Binding InstallOllamaModelCommand}" FontSize="12" />
                    <TextBlock Text="{Binding Text[OllamaLocateToInstall]}" IsVisible="{Binding NeedsOllamaExecutable}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Text[OllamaPullHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <Expander Header="{Binding Text[LocalModelConnectionSettings]}" IsVisible="{Binding UseAgent}" FontSize="12">
                    <StackPanel Spacing="7" Margin="0,6,0,0">
                      <TextBox Text="{Binding AgentEndpoint}" Watermark="http://localhost:11434" />
                      <TextBox Text="{Binding AgentModel}" Watermark="{Binding Text[AgentModelHint]}" />
                    </StackPanel>
                  </Expander>
                  <TextBlock Text="{Binding Text[AgentHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Text[ImageContextHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
              <TextBlock Text="{Binding Text[CleanerRulesHelp]}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="3,0" />
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding Text[TaskModelTitle]}" Classes="label" />
              <Border Name="AssistantConnectedCard" IsVisible="{Binding ShowAssistantSummary}" Background="#102B26" BorderBrush="#245F4E" BorderThickness="1" CornerRadius="11" Padding="12">
                <Grid ColumnDefinitions="*,34">
                  <StackPanel Spacing="7"><TextBlock Text="{Binding AssistantModelName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="7" Height="7" Fill="{Binding ChatConnectionColor}" VerticalAlignment="Center" /><TextBlock Text="{Binding ChatConnectionLabel}" Foreground="{Binding ChatConnectionColor}" FontSize="12" /></StackPanel><TextBlock Text="{Binding AssistantLocation}" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel>
                  <Button Name="EditAssistantButton" Grid.Column="1" Command="{Binding EditAssistantCommand}" Classes="icon" VerticalAlignment="Top" ToolTip.Tip="{Binding Text[EditModel]}" AutomationProperties.Name="{Binding Text[EditModel]}"><TextBlock Text="✎" FontSize="20" /></Button>
                </Grid>
              </Border>
              <Expander Classes="model" Name="AssistantOptions" IsVisible="{Binding ShowAssistantEditor}" IsExpanded="{Binding ChatModelExpanded}">
                <Expander.Header><StackPanel Orientation="Horizontal" Spacing="13"><Path Classes="outline" Data="{StaticResource CloudIcon}" IsVisible="{Binding IsRemote}" Stroke="#77B8FF" /><Path Classes="outline" Data="{StaticResource MonitorIcon}" IsVisible="{Binding IsOllama}" /><TextBlock Text="{Binding AssistantModelName}" TextTrimming="CharacterEllipsis" MaxWidth="190" /></StackPanel></Expander.Header>
                <StackPanel Spacing="10" Margin="12,6,12,14">
                  <ComboBox Name="ProviderSelector" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" />
                  <StackPanel Spacing="9" IsVisible="{Binding IsOllama}">
                    <TextBox Text="{Binding OllamaEndpoint}" Watermark="http://localhost:11434" />
                    <TextBox Text="{Binding LocalModel}" Watermark="{Binding Text[ModelNameHint]}" />
                    <ComboBox Name="LocalModelSelector" ItemsSource="{Binding LocalModels}" SelectedItem="{Binding SelectedLocalModel}" IsVisible="{Binding HasLocalModels}" PlaceholderText="{Binding Text[LocalModelsHint]}" />
                    <Grid ColumnDefinitions="*,Auto"><Button Content="{Binding Text[Connect]}" Command="{Binding CheckChatCommand}" /><Button Grid.Column="1" Content="↻" Command="{Binding RefreshModelsCommand}" Margin="7,0,0,0" ToolTip.Tip="{Binding Text[RefreshModels]}" /></Grid>
                  </StackPanel>
                  <StackPanel Spacing="9" IsVisible="{Binding IsRemote}">
                    <TextBox Text="{Binding ApiEndpoint}" Watermark="https://…/v1/chat/completions" /><TextBox Text="{Binding ApiModel}" Watermark="{Binding Text[ApiModelHint]}" />
                    <CheckBox Name="UseApiKeyCheckbox" IsChecked="{Binding UseApiKey}" Content="{Binding Text[UseApiKey]}" />
                    <TextBox Name="ApiKeyBox" Text="{Binding ApiKey}" IsVisible="{Binding UseApiKey}" PasswordChar="●" Watermark="{Binding Text[ApiKeyHint]}" />
                    <TextBlock Name="AnonymousApiHelp" Text="{Binding Text[AnonymousApiHelp]}" IsVisible="{Binding !UseApiKey}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    <Button Content="{Binding Text[Connect]}" Command="{Binding CheckChatCommand}" /><TextBlock Text="{Binding Text[ApiConnectionHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </Expander>
              <TextBlock Text="{Binding AssistantLocation}" IsVisible="{Binding ShowAssistantEditor}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="3,0" />
            </StackPanel>
            <Border Name="ContextTrimmingOptions" BorderBrush="#1C3042" BorderThickness="0,1,0,0" Padding="0,14,0,0">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Text[ContextTrimming]}" Classes="label" ToolTip.Tip="{Binding Text[TrimmingHelp]}" />
                <RadioButton Name="MinimalTrimRadio" GroupName="Trimming" Theme="{StaticResource TrimmingRadioTheme}" IsChecked="{Binding MinimalTrimming}" ToolTip.Tip="{Binding Text[TrimMinimalHelp]}"><TextBlock Text="{Binding Text[TrimMinimal]}" FontSize="13" /></RadioButton>
                <RadioButton Name="ModerateTrimRadio" GroupName="Trimming" Theme="{StaticResource TrimmingRadioTheme}" IsChecked="{Binding ModerateTrimming}" ToolTip.Tip="{Binding Text[TrimModerateHelp]}"><TextBlock Text="{Binding Text[TrimModerate]}" FontSize="13" /></RadioButton>
                <RadioButton Name="MaximumTrimRadio" GroupName="Trimming" Theme="{StaticResource TrimmingRadioTheme}" IsChecked="{Binding MaximumTrimming}" ToolTip.Tip="{Binding Text[TrimMaximumHelp]}"><TextBlock Text="{Binding Text[TrimMaximum]}" FontSize="13" /></RadioButton>
                <RadioButton Name="CustomTrimRadio" GroupName="Trimming" Theme="{StaticResource TrimmingRadioTheme}" IsChecked="{Binding CustomTrimming}" ToolTip.Tip="{Binding Text[TrimCustomHelp]}"><TextBlock Text="{Binding Text[TrimCustom]}" FontSize="13" /></RadioButton>
                <StackPanel Name="CustomCleanupOptions" Spacing="8" IsVisible="{Binding CustomTrimming}" Margin="8,0,0,0">
                  <RadioButton Name="CodeCleanupRadio" GroupName="CustomCleanup" Theme="{StaticResource TrimmingRadioTheme}" IsChecked="{Binding CustomCodeCleanup}"><TextBlock Text="{Binding Text[CleanCode]}" FontSize="12" TextWrapping="Wrap" /></RadioButton>
                  <RadioButton Name="TextCleanupRadio" GroupName="CustomCleanup" Theme="{StaticResource TrimmingRadioTheme}" IsChecked="{Binding CustomTextCleanup}"><TextBlock Text="{Binding Text[CleanTextByDescription]}" FontSize="12" TextWrapping="Wrap" /></RadioButton>
                </StackPanel>
                <TextBlock Text="{Binding TrimmingSummary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Name="CodeCleanupHint" Text="{Binding Text[CleanCodeHelp]}" IsVisible="{Binding ShowCodeCleanupHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Name="AutomaticTrimmingHint" Text="{Binding AutomaticTrimmingHint}" IsVisible="{Binding ShowAutomaticTrimmingHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <StackPanel Name="CustomTrimmingEditor" Spacing="4" IsVisible="{Binding ShowTrimmingInstructions}">
                  <TextBox Name="TrimmingInstructionsBox" Text="{Binding TrimmingInstructions}" MaxLength="1000" IsEnabled="{Binding ShowTrimmingInstructions}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" MaxHeight="120" FontSize="12" LineHeight="18" Watermark="{Binding Text[TrimInstructionsHint]}" />
                  <TextBlock Text="{Binding InstructionsCount}" Classes="muted" FontSize="12" HorizontalAlignment="Right" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
  <Border Name="StorageNotification" Classes="card" Margin="24" Padding="16,12" MaxWidth="640" VerticalAlignment="Bottom" HorizontalAlignment="Center" IsVisible="{Binding HasStorageMessage}">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding StorageMessage}" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Content="×" Classes="icon" Command="{Binding DismissStorageMessageCommand}" /></Grid>
  </Border>
  <Border Name="SettingsBackdrop" Background="#B800050C" Opacity="{Binding ModalShade}" IsHitTestVisible="{Binding ModalOpen}">
    <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut" /></Transitions></Border.Transitions>
  </Border>
  <Border Name="DeleteConfirmationDialog" Background="#0D1C2A" BorderBrush="#294055" BorderThickness="1" CornerRadius="16"
          Width="440" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
          local:SmoothVisibility.IsShown="{Binding DeleteConfirmationOpen}" AutomationProperties.Name="{Binding Text[DeleteConfirmationTitle]}">
    <StackPanel Spacing="18">
      <TextBlock Text="{Binding Text[DeleteConfirmationTitle]}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding PendingDeleteTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="72" />
      <TextBlock Text="{Binding Text[DeleteConfirmationMessage]}" Classes="muted" TextWrapping="Wrap" LineHeight="22" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
        <Button Name="CancelDeleteButton" Content="{Binding Text[CancelDeletion]}" Command="{Binding CancelDeleteChatCommand}" IsDefault="True" />
        <Button Name="ConfirmDeleteButton" Content="{Binding Text[DeleteChat]}" Command="{Binding ConfirmDeleteChatCommand}" Classes="danger" />
      </StackPanel>
    </StackPanel>
  </Border>
  </Grid>
</Window>
