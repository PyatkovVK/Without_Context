<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ContextGuard.App" x:Class="ContextGuard.App.App" Name="Without Context" RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type local:LocalizedOption}"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate>
  </Application.DataTemplates>
  <Application.Resources>
    <SolidColorBrush x:Key="ExpanderHeaderBackground">#0D1C2A</SolidColorBrush>
    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver">#183047</SolidColorBrush>
    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed">#183047</SolidColorBrush>
    <SolidColorBrush x:Key="CalmHoverBackground">#183047</SolidColorBrush>
    <LinearGradientBrush x:Key="PanelBackground" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#07131F" Offset="0" /><GradientStop Color="#04101B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ChatBackground" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#0C1A27" Offset="0" /><GradientStop Color="#07131E" Offset="1" />
    </LinearGradientBrush>
    <StreamGeometry x:Key="PlusIcon">M12,3 L12,21 M3,12 L21,12</StreamGeometry>
    <StreamGeometry x:Key="ChatIcon">M4,4 L20,4 L20,16 L10,16 L5,21 L5,16 L4,16 Z M8,8 L16,8 M8,12 L14,12</StreamGeometry>
    <StreamGeometry x:Key="FolderIcon">M3,6 L10,6 L12,9 L21,9 L21,20 L3,20 Z M3,10 L21,10</StreamGeometry>
    <StreamGeometry x:Key="MonitorIcon">M3,4 L21,4 L21,16 L3,16 Z M12,16 L12,21 M8,21 L16,21</StreamGeometry>
    <StreamGeometry x:Key="CloudIcon">M6,18 C0,18 1,10 6,10 C5,3 16,2 17,9 C24,9 24,18 18,18 Z</StreamGeometry>
    <StreamGeometry x:Key="ShieldIcon">M12,2 L21,6 L20,14 C19,18 16,21 12,23 C8,21 5,18 4,14 L3,6 Z M8,12 L11,15 L16,9</StreamGeometry>
    <StreamGeometry x:Key="SettingsIcon">M12,3 L15,3 L16,6 L19,7 L22,6 L24,10 L21,12 L21,15 L24,17 L22,21 L19,20 L16,21 L15,24 L10,24 L9,21 L6,20 L3,21 L1,17 L4,15 L4,12 L1,10 L3,6 L6,7 L9,6 L10,3 Z M17,13 A4,4 0 1 1 9,13 A4,4 0 1 1 17,13</StreamGeometry>
    <StreamGeometry x:Key="ArchiveIcon">M3,4 L21,4 L21,8 L3,8 Z M5,8 L5,21 L19,21 L19,8 M9,13 L15,13</StreamGeometry>
    <StreamGeometry x:Key="TrashIcon">M4,6 L20,6 M9,6 L9,3 L15,3 L15,6 M6,6 L7,21 L17,21 L18,6 M10,10 L10,17 M14,10 L14,17</StreamGeometry>
    <StreamGeometry x:Key="ArrowIcon">M12,21 L12,3 M5,10 L12,3 L19,10</StreamGeometry>
    <StreamGeometry x:Key="UserIcon">M16,7 A4,4 0 1 1 8,7 A4,4 0 1 1 16,7 M4,22 L4,20 C4,12 20,12 20,20 L20,22</StreamGeometry>
    <StreamGeometry x:Key="CloseIcon">M5,5 L19,19 M19,5 L5,19</StreamGeometry>
    <StreamGeometry x:Key="ChevronLeftIcon">M15,4 L7,12 L15,20</StreamGeometry>
    <StreamGeometry x:Key="ChevronRightIcon">M9,4 L17,12 L9,20</StreamGeometry>
    <ControlTheme x:Key="CalmButtonTheme" TargetType="Button">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#ButtonSurface"><Setter Property="Background" Value="{StaticResource CalmHoverBackground}" /></Style>
      <Style Selector="^:pressed /template/ Border#ButtonSurface"><Setter Property="Background" Value="{StaticResource CalmHoverBackground}" /></Style>
      <Style Selector="^:focus-visible /template/ Border#ButtonSurface"><Setter Property="BorderBrush" Value="#77B8FF" /><Setter Property="BorderThickness" Value="1" /></Style>
      <Style Selector="^:disabled /template/ Border#ButtonSurface"><Setter Property="Background" Value="{Binding $parent[Button].Background}" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="ChatItemTheme" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#E5EDF6" />
      <Setter Property="Padding" Value="12,12" /><Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover"><Setter Property="Background" Value="#0F2233" /></Style>
      <Style Selector="^:selected"><Setter Property="Background" Value="#14293D" /></Style>
      <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="#369AFF" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="TrimmingRadioTheme" TargetType="RadioButton">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="20,*" Background="Transparent" MinHeight="24">
            <Border Name="RadioRing" Width="18" Height="18" CornerRadius="9" BorderThickness="2" BorderBrush="#687C96" VerticalAlignment="Center">
              <Border.Transitions><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.35" Easing="CubicEaseInOut" /></Transitions></Border.Transitions>
              <Ellipse Name="RadioDot" Width="8" Height="8" Fill="#369AFF" Opacity="0">
                <Ellipse.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseInOut" /></Transitions></Ellipse.Transitions>
              </Ellipse>
            </Border>
            <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Border#RadioRing"><Setter Property="BorderBrush" Value="#369AFF" /></Style>
      <Style Selector="^:checked /template/ Ellipse#RadioDot"><Setter Property="Opacity" Value="1" /></Style>
      <Style Selector="^:focus-visible /template/ Border#RadioRing"><Setter Property="BorderBrush" Value="#B0D7FF" /></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.55" /></Style>
    </ControlTheme>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter" /><Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#E5EDF6" /><Setter Property="Background" Value="#020B13" />
    </Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#91A4BD" /></Style>
    <Style Selector="SelectableTextBlock.muted"><Setter Property="Foreground" Value="#91A4BD" /></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="Path.outline">
      <Setter Property="Stroke" Value="#E1EAF4" /><Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="Stretch" Value="Uniform" /><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Path.sidebar-chevron">
      <Setter Property="Width" Value="12" /><Setter Property="Height" Value="24" />
      <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource PanelBackground}" /><Setter Property="BorderBrush" Value="#1D3346" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#101F2D" /><Setter Property="BorderBrush" Value="#263C50" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#0D1C2A" /><Setter Property="BorderBrush" Value="#294055" />
      <Setter Property="CornerRadius" Value="11" /><Setter Property="Padding" Value="12,10" /><Setter Property="MinHeight" Value="42" />
      <Setter Property="SelectionBrush" Value="#234F75" /><Setter Property="Foreground" Value="#DDE6F0" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="#369AFF" /></Style>
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#0D1C2A" /><Setter Property="BorderBrush" Value="#243548" />
    </Style>
    <Style Selector="TextBox.composer:disabled /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#0D1C2A" /><Setter Property="BorderBrush" Value="#294055" /><Setter Property="CornerRadius" Value="11" />
      <Setter Property="MinHeight" Value="42" /><Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Theme" Value="{StaticResource CalmButtonTheme}" />
      <Setter Property="CornerRadius" Value="11" /><Setter Property="Padding" Value="13,10" />
      <Setter Property="Background" Value="#102233" /><Setter Property="BorderBrush" Value="#294055" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.35" Easing="CubicEaseInOut" /></Transitions></Setter>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#369AFF" /><Setter Property="Foreground" Value="#03121F" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ Border#ButtonSurface"><Setter Property="Background" Value="#369AFF" /></Style>
    <Style Selector="Button.primary:pressed /template/ Border#ButtonSurface"><Setter Property="Background" Value="#369AFF" /></Style>
    <Style Selector="Button.ghost"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="#A9BCD2" /></Style>
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="7" />
      <Setter Property="MinHeight" Value="34" /><Setter Property="MinWidth" Value="34" /><Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="#842633" /><Setter Property="Foreground" Value="#FF5267" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.round"><Setter Property="CornerRadius" Value="22" /><Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="10" /></Style>
    <Style Selector="Button.sidebar-toggle">
      <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="44" /><Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Expander.model">
      <Setter Property="Background" Value="#0D1C2A" /><Setter Property="BorderBrush" Value="#294055" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ContentTransition"><CrossFade Duration="0:0:0.5" FadeInEasing="CubicEaseInOut" FadeOutEasing="CubicEaseInOut" /></Setter>
    </Style>
    <Style Selector="CheckBox"><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="MenuItem.danger"><Setter Property="Foreground" Value="#FF5267" /></Style>
  </Application.Styles>
</Application>
