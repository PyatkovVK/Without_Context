<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ContextGuard.App.SettingsWindow" Title="{Binding Text[Settings]}" Icon="/images/icon.png"
        Width="580" Height="710" MinWidth="580" MinHeight="710" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Name="SettingsContent" RowDefinitions="Auto,*,Auto" Margin="24,20">
    <StackPanel Spacing="5" Margin="0,0,0,16">
      <TextBlock Text="{Binding Text[Settings]}" FontSize="23" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Text[SettingsHelp]}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
    </StackPanel>
      <StackPanel Grid.Row="1" Spacing="13" IsEnabled="{Binding NotBusy}">
        <Grid ColumnDefinitions="*,245">
          <TextBlock Text="{Binding Text[Language]}" Classes="label" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" Name="LanguageSelector" ItemsSource="{Binding Languages}" SelectedIndex="{Binding LanguageIndex}" />
        </Grid>
        <StackPanel Spacing="13" DataContext="{Binding Active.Session}">
          <Grid ColumnDefinitions="*,245">
            <TextBlock Text="{Binding Text[ProtectionSettings]}" Classes="label" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Name="ProfileSelector" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />
          </Grid>
          <StackPanel Spacing="7">
            <TextBlock Text="{Binding Text[CustomValues]}" Classes="label" />
            <TextBox Text="{Binding CustomTerms}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" Watermark="{Binding Text[CustomValuesHint]}" />
            <TextBlock Text="{Binding Text[CustomValuesHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="*,120">
            <TextBlock Text="{Binding Text[ContextLimit]}" Classes="label" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding ContextLimit}" Minimum="4000" Maximum="96000" Increment="4000" FormatString="0" ShowButtonSpinner="False" />
          </Grid>
          <CheckBox IsChecked="{Binding RestoreLocally}" Content="{Binding Text[RestoreLocally]}" FontSize="12" />
        </StackPanel>
        <Border BorderBrush="#243B4F" BorderThickness="0,1,0,0" Padding="0,13,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Text[ChatStorageFolder]}" Classes="label" />
            <TextBox Name="StorageFolderBox" Text="{Binding StorageFolder}" IsReadOnly="True" FontSize="11" />
            <TextBlock Text="{Binding Text[ChatStorageHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,3,0,0">
              <Button Content="{Binding Text[ExportAllChats]}" Command="{Binding ExportAllCommand}" HorizontalAlignment="Left" />
              <Button Grid.Column="1" Content="{Binding Text[ClearAllChats]}" Classes="ghost" Command="{Binding ClearAllCommand}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    <Button Grid.Row="2" Content="{Binding Text[Done]}" Click="Done" Classes="primary" HorizontalAlignment="Right" MinWidth="90" Margin="0,12,0,0" />
  </Grid>
</Window>
